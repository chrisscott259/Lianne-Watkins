---
import type { EmbedPlaceholderSectionDefinition, Tone } from "../../data/content-types";

interface Props {
  section: EmbedPlaceholderSectionDefinition;
}

const { section } = Astro.props;

const labelClass =
  "inline-flex items-center gap-3.5 text-[0.72rem] font-semibold uppercase tracking-[0.18em] text-forest before:h-[1.5px] before:w-7 before:rounded-full before:bg-forest before:content-['']";
const backgroundMap: Record<Tone, string> = {
  cream: "bg-cream",
  mint: "bg-mint",
  linen: "bg-linen"
};
const backgroundClass = backgroundMap[section.background ?? "cream"];
---

<section class:list={[backgroundClass, "py-18 sm:py-24 lg:py-30"]}>
  <div class="mx-auto w-full max-w-[1200px] px-6 sm:px-12">
    <div
      data-reveal
      data-visible="false"
      class="max-w-[760px] opacity-0 translate-y-7 transition duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] data-[visible=true]:translate-y-0 data-[visible=true]:opacity-100"
    >
      {section.eyebrow && <p class={labelClass}>{section.eyebrow}</p>}
      <h2 class="mt-5 max-w-[16ch] text-[clamp(2.15rem,4.4vw,3.35rem)] leading-[1.03] tracking-[-0.04em] text-charcoal">
        {section.title}
      </h2>
      {section.lead && <p class="mt-6 text-[1.08rem] leading-[1.82] text-[#5a5550]">{section.lead}</p>}
    </div>

    <div
      data-reveal
      data-visible="false"
      class="mt-10 rounded-[1.3rem] border border-dashed border-forest/25 bg-white/70 p-8 opacity-0 translate-y-7 shadow-[0_2px_12px_rgba(45,106,79,0.04)] transition duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] data-[visible=true]:translate-y-0 data-[visible=true]:opacity-100 sm:p-12"
    >
      <div class="mx-auto max-w-[34rem] text-center">
        <p class="text-[0.72rem] font-semibold uppercase tracking-[0.18em] text-forest/60">Booking Placeholder</p>
        <h3 class="mt-4 text-[1.85rem] leading-[1.08] tracking-[-0.03em] text-charcoal">
          {section.placeholderTitle ?? "Scheduling embed will live here."}
        </h3>
        <p class="mt-4 text-[0.98rem] leading-[1.8] text-[#6a6460]">
          {section.placeholderBody ?? "This container is intentionally reserved for the eventual booking/calendar embed."}
        </p>
      </div>
    </div>
  </div>
</section>
