---
import type { QuestionListSectionDefinition, Tone } from "../../data/content-types";

interface Props {
  section: QuestionListSectionDefinition;
}

const { section } = Astro.props;

const labelClass =
  "inline-flex items-center gap-3.5 text-[0.72rem] font-semibold uppercase tracking-[0.18em] text-forest before:h-[1.5px] before:w-7 before:rounded-full before:bg-forest before:content-['']";
const backgroundMap: Record<Tone, string> = {
  cream: "bg-cream",
  mint: "bg-mint",
  linen: "bg-linen"
};
const backgroundClass = backgroundMap[section.background ?? "cream"];
const columnClass = section.columns === 2 ? "lg:grid-cols-2" : "grid-cols-1";
---

<section class:list={[backgroundClass, "py-18 sm:py-24 lg:py-30"]}>
  <div class="mx-auto w-full max-w-[1200px] px-6 sm:px-12">
    {(section.eyebrow || section.title || section.lead) && (
      <div
        data-reveal
        data-visible="false"
        class="max-w-[760px] opacity-0 translate-y-7 transition duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] data-[visible=true]:translate-y-0 data-[visible=true]:opacity-100"
      >
        {section.eyebrow && <p class={labelClass}>{section.eyebrow}</p>}
        {section.title && (
          <h2 class="mt-5 max-w-[16ch] text-[clamp(2.15rem,4.4vw,3.35rem)] leading-[1.03] tracking-[-0.04em] text-charcoal">
            {section.title}
          </h2>
        )}
        {section.lead && <p class="mt-6 text-[1.08rem] leading-[1.82] text-[#5a5550]">{section.lead}</p>}
      </div>
    )}

    <div class:list={["mt-10 grid gap-5", columnClass]}>
      {section.items.map((item, index) => (
        <article
          data-reveal
          data-visible="false"
          class="rounded-[1.15rem] bg-white px-7 pb-8 pt-8 opacity-0 translate-y-7 shadow-[0_2px_12px_rgba(45,106,79,0.05)] transition duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] data-[visible=true]:translate-y-0 data-[visible=true]:opacity-100"
          style={`transition-delay:${Math.min(index * 60, 300)}ms`}
        >
          <h3 class="text-[1.45rem] leading-[1.12] tracking-[-0.03em] text-charcoal">{item.question}</h3>
          <p class="mt-4 text-[0.98rem] leading-[1.8] text-[#6a6460]">{item.answer}</p>
        </article>
      ))}
    </div>
  </div>
</section>
