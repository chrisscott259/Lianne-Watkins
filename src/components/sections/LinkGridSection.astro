---
import type { LinkGridSectionDefinition, Tone } from "../../data/content-types";

interface Props {
  section: LinkGridSectionDefinition;
}

const { section } = Astro.props;

const labelClass =
  "inline-flex items-center gap-3.5 text-[0.72rem] font-semibold uppercase tracking-[0.18em] text-forest before:h-[1.5px] before:w-7 before:rounded-full before:bg-forest before:content-['']";
const backgroundMap: Record<Tone, string> = {
  cream: "bg-cream",
  mint: "bg-mint",
  linen: "bg-linen"
};
const backgroundClass = backgroundMap[section.background ?? "cream"];
const columnClass =
  section.columns === 1
    ? "grid-cols-1"
    : section.columns === 2
      ? "grid-cols-1 md:grid-cols-2"
      : "grid-cols-1 sm:grid-cols-2 xl:grid-cols-3";
const ctaClass =
  "relative inline-flex items-center justify-center overflow-hidden rounded-full border border-forest px-7 py-4 text-center text-[0.8rem] font-semibold uppercase tracking-[0.08em] text-forest transition-[background-color,color,transform] duration-300 ease-out hover:-translate-y-0.5 hover:bg-forest hover:text-white";
---

<section class:list={[backgroundClass, "py-18 sm:py-24 lg:py-30"]}>
  <div class="mx-auto w-full max-w-[1200px] px-6 sm:px-12">
    {(section.eyebrow || section.title || section.lead) && (
      <div data-reveal data-visible="false" class="max-w-[760px] opacity-0 translate-y-7 transition duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] data-[visible=true]:translate-y-0 data-[visible=true]:opacity-100">
        {section.eyebrow && <p class={labelClass}>{section.eyebrow}</p>}
        {section.title && (
          <h2 class="mt-5 max-w-[15ch] text-[clamp(2.2rem,4.4vw,3.35rem)] leading-[1.02] tracking-[-0.04em] text-charcoal">
            {section.title}
          </h2>
        )}
        {section.lead && <p class="mt-6 max-w-[38rem] text-[1.08rem] leading-[1.82] text-[#5a5550]">{section.lead}</p>}
      </div>
    )}

    {section.groups.map((group, groupIndex) => (
      <div class:list={["mt-10 grid gap-3", columnClass]}>
        {group.links.map((link, index) => (
          <a
            href={link.href}
            data-reveal
            data-visible="false"
            class="group relative flex items-center justify-between overflow-hidden rounded-[0.85rem] border border-forest/8 bg-white px-5 py-5 text-[0.96rem] font-medium text-charcoal transition-[background-color,border-color,transform,box-shadow,opacity] duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:border-forest hover:bg-mint hover:shadow-[0_2px_12px_rgba(45,106,79,0.05)] opacity-0 translate-y-7 data-[visible=true]:translate-y-0 data-[visible=true]:opacity-100 after:absolute after:bottom-0 after:left-0 after:h-[2px] after:w-full after:origin-left after:scale-x-0 after:bg-[linear-gradient(90deg,var(--color-forest),var(--color-sage))] after:transition-transform after:duration-300 after:content-[''] hover:after:scale-x-100"
            style={`transition-delay:${groupIndex * 120 + index * 35}ms`}
          >
            <span>{link.label}</span>
            <span class="text-[1.1rem] text-forest/35 transition-[transform,opacity] duration-300 group-hover:translate-x-1 group-hover:text-forest">
              &rarr;
            </span>
          </a>
        ))}
      </div>
    ))}

    {section.cta && (
      <div data-reveal data-visible="false" class="mt-12 opacity-0 translate-y-7 transition duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] data-[visible=true]:translate-y-0 data-[visible=true]:opacity-100">
        <a href={section.cta.href} class={ctaClass}>{section.cta.label}</a>
      </div>
    )}
  </div>
</section>
