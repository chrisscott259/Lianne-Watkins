---
import type { RichTextSectionDefinition, Tone } from "../../data/content-types";

interface Props {
  section: RichTextSectionDefinition;
}

const { section } = Astro.props;

const labelClass =
  "inline-flex items-center gap-3.5 text-[0.72rem] font-semibold uppercase tracking-[0.18em] text-forest before:h-[1.5px] before:w-7 before:rounded-full before:bg-forest before:content-['']";
const backgroundMap: Record<Tone, string> = {
  cream: "bg-cream",
  mint: "bg-mint",
  linen: "bg-linen"
};
const backgroundClass = backgroundMap[section.background ?? "cream"];
const ctaClass =
  "relative inline-flex items-center justify-center overflow-hidden rounded-full bg-forest px-7 py-4 text-center text-[0.8rem] font-semibold uppercase tracking-[0.08em] text-white transition-[background-color,box-shadow,transform] duration-300 ease-out hover:-translate-y-0.5 hover:bg-[#245a42] hover:shadow-[0_10px_32px_rgba(45,106,79,0.28)]";
---

<section class:list={[backgroundClass, "py-18 sm:py-24 lg:py-30"]}>
  <div class="mx-auto w-full max-w-[760px] px-6 sm:px-12">
    <div
      data-reveal
      data-visible="false"
      class="opacity-0 translate-y-7 transition duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] data-[visible=true]:translate-y-0 data-[visible=true]:opacity-100"
    >
      {section.eyebrow && <p class={labelClass}>{section.eyebrow}</p>}
      <h2 class="mt-5 max-w-[16ch] text-[clamp(2.15rem,4.4vw,3.35rem)] leading-[1.03] tracking-[-0.04em] text-charcoal">
        {section.title}
      </h2>
      {section.lead && <p class="mt-6 text-[1.08rem] leading-[1.82] text-[#5a5550]">{section.lead}</p>}
    </div>

    <div class="mt-6 space-y-5">
      {section.paragraphs.map((paragraph, index) => (
        <p
          data-reveal
          data-visible="false"
          class="opacity-0 translate-y-7 text-[0.98rem] leading-[1.82] text-[#6a6460] transition duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] data-[visible=true]:translate-y-0 data-[visible=true]:opacity-100"
          style={`transition-delay:${Math.min(index * 60, 240)}ms`}
        >
          {paragraph}
        </p>
      ))}
    </div>

    {section.quote && (
      <blockquote
        data-reveal
        data-visible="false"
        class="mt-8 border-l-[3px] border-forest/20 pl-5 font-heading text-[1.45rem] leading-[1.35] tracking-[-0.02em] text-charcoal/86 opacity-0 translate-y-7 transition duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] data-[visible=true]:translate-y-0 data-[visible=true]:opacity-100"
      >
        {section.quote}
      </blockquote>
    )}

    {section.cta && (
      <div
        data-reveal
        data-visible="false"
        class="mt-9 opacity-0 translate-y-7 transition duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] data-[visible=true]:translate-y-0 data-[visible=true]:opacity-100"
      >
        <a href={section.cta.href} class={ctaClass}>{section.cta.label}</a>
      </div>
    )}
  </div>
</section>
