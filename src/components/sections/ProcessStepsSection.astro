---
import type { ProcessStepsSectionDefinition, Tone } from "../../data/content-types";

interface Props {
  section: ProcessStepsSectionDefinition;
}

const { section } = Astro.props;

const labelClass =
  "inline-flex items-center gap-3.5 text-[0.72rem] font-semibold uppercase tracking-[0.18em] text-forest before:h-[1.5px] before:w-7 before:rounded-full before:bg-forest before:content-['']";
const backgroundMap: Record<Tone, string> = {
  cream: "bg-cream",
  mint: "bg-mint",
  linen: "bg-linen"
};
const backgroundClass = backgroundMap[section.background ?? "mint"];
const primaryButtonClass =
  "relative inline-flex items-center justify-center overflow-hidden rounded-full bg-forest px-7 py-4 text-center text-[0.8rem] font-semibold uppercase tracking-[0.08em] text-white transition-[background-color,box-shadow,transform] duration-300 ease-out hover:-translate-y-0.5 hover:bg-[#245a42] hover:shadow-[0_10px_32px_rgba(45,106,79,0.28)]";
---

<section class:list={[backgroundClass, "py-18 sm:py-24 lg:py-30"]}>
  <div class="mx-auto w-full max-w-[1200px] px-6 sm:px-12">
    <div data-reveal data-visible="false" class="opacity-0 translate-y-7 transition duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] data-[visible=true]:translate-y-0 data-[visible=true]:opacity-100">
      {section.eyebrow && <p class={labelClass}>{section.eyebrow}</p>}
      <h2 class="mt-5 max-w-[14ch] text-[clamp(2.2rem,4.5vw,3.45rem)] leading-[1.02] tracking-[-0.04em] text-charcoal">
        {section.title}
      </h2>
      {section.lead && <p class="mt-6 max-w-[38rem] text-[1.08rem] leading-[1.82] text-[#5a5550]">{section.lead}</p>}
    </div>

    <div class="mt-12 grid gap-5 lg:grid-cols-3">
      {section.steps.map((step, index) => (
        <article
          data-reveal
          data-visible="false"
          class="relative overflow-hidden rounded-[1.15rem] bg-white px-7 pb-8 pt-14 opacity-0 translate-y-7 shadow-[0_2px_12px_rgba(45,106,79,0.05)] transition-[transform,box-shadow,opacity] duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-1 hover:shadow-[0_10px_30px_rgba(45,106,79,0.09)] data-[visible=true]:translate-y-0 data-[visible=true]:opacity-100"
          style={`transition-delay:${index * 90}ms`}
        >
          <span class="pointer-events-none absolute right-7 top-5 font-heading text-[4.2rem] leading-none text-forest/10">
            {step.number ?? String(index + 1).padStart(2, "0")}
          </span>
          {step.eyebrow && (
            <p class="inline-flex items-center gap-3 text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-forest before:h-px before:w-6 before:rounded-full before:bg-forest before:content-['']">
              {step.eyebrow}
            </p>
          )}
          <h3 class="mt-4 text-[1.7rem] leading-[1.1] tracking-[-0.03em] text-charcoal">{step.title}</h3>
          <p class="mt-4 text-[0.98rem] leading-[1.8] text-[#6a6460]">{step.body}</p>
        </article>
      ))}
    </div>

    {section.cta && (
      <div data-reveal data-visible="false" class="mt-12 opacity-0 translate-y-7 transition duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] data-[visible=true]:translate-y-0 data-[visible=true]:opacity-100">
        <a href={section.cta.href} class={primaryButtonClass}>{section.cta.label}</a>
      </div>
    )}
  </div>
</section>
