---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Not Found", description = "The page you are looking for doesn't exist." } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="m-0 min-h-screen bg-[linear-gradient(160deg,var(--color-cream)_0%,var(--color-linen)_55%,#f3ebe0_100%)] font-body text-charcoal antialiased">
    <slot />
  </body>
</html>
